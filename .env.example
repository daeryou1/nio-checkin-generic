# 复制为 .env 后填写。凭据只留在本机, 不要提交到 git / 发给别人 / 传网盘。
# 推荐: 运行 python server.py 打开本地配置页, 网页里粘贴即可自动写入 accounts.json
# (走 .env 的方式适合青龙等只有环境变量面板的平台)

# 【可选】Authorization, 支持多账号: 换行或 & 分隔, 别名自动 NIO1/NIO2...
# 值可以是完整 "Bearer eyJ..." 或只填 token 本体
NIO_AUTH=

# 【可选】App User-Agent (多账号共用)。留空用内置 UA
NIO_UA=

# 【可选】每日签到基准时间 (每个账号还会叠加 0~NIO_JITTER 分钟的随机偏移错峰)
NIO_HOUR=9
NIO_MINUTE=3
NIO_JITTER=20

# 当天失败后额外重试次数 / 重试间隔(分钟)
NIO_MAX_RETRY=3
NIO_RETRY_GAP=30

# 【可选】通知 webhook: 企业微信机器人 / Server酱 / Bark / PushPlus / 钉钉 / 飞书 / Telegram / 自定义
NIO_NOTIFY_URL=
# 成功是否也推送 (默认推送, 便于确认还活着)
NIO_NOTIFY_DAILY=1
